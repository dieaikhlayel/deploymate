# DeployMate Configuration
DEPLOYMATE_ENV=development
DEPLOYMATE_LOG_LEVEL=INFO
DEPLOYMATE_CONFIG_DIR=./configs

# Database (optional)
DEPLOYMATE_DB_URL=sqlite:///deploymate.db

# Security
DEPLOYMATE_SECRET_KEY=your-secret-key-here
DEPLOYMATE_API_TOKEN=your-api-token-here

# SSH
DEPLOYMATE_SSH_TIMEOUT=30
DEPLOYMATE_SSH_MAX_RETRIES=3

# Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
SLACK_CHANNEL=#deployments
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-password

# Monitoring
MONITORING_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10